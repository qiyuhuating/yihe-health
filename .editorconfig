root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# 压缩产物：不做空白处理，也不手工编辑
[*.min.js]
insert_final_newline = ignore
trim_trailing_whitespace = ignore
