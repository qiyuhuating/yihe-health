[Unit]
Description=Yihe care API and incident dispatcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yihe
Group=yihe
WorkingDirectory=/var/lib/yihe
EnvironmentFile=/etc/yihe/yihe.env
ExecStart=/opt/yihe/bin/yihe-server
Restart=always
RestartSec=5s
TimeoutStopSec=20s
StateDirectory=yihe
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/yihe
UMask=0077

[Install]
WantedBy=multi-user.target
