{
  "name": "yihe-ui",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api:generate": "node scripts/generate-api-types.mjs",
    "api:check": "node scripts/generate-api-types.mjs --check",
    "test:api-drift": "node scripts/test-api-drift.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "test:watch": "vitest",
    "typecheck": "npm run check:boundaries && node scripts/check-typescript-scope.ts && vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.test.json",
    "typecheck:stable": "npm run check:boundaries && node scripts/check-typescript-scope.ts && vue-tsc --noEmit --stableTypeOrdering -p tsconfig.app.json && tsc --noEmit --stableTypeOrdering -p tsconfig.node.json && vue-tsc --noEmit --stableTypeOrdering -p tsconfig.test.json",
    "api:tools:ci": "npm ci --prefix tools/openapi --ignore-scripts --no-audit --no-fund",
    "check:vue36": "node scripts/check-vue36-readiness.ts",
    "check:boundaries": "node scripts/check-module-boundaries.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "@tauri-apps/api": "2.12.5",
    "axios": "1.21.1",
    "echarts": "6.1.0",
    "element-plus": "2.14.8",
    "leaflet": "1.9.4",
    "vue": "3.5.46",
    "vue-router": "5.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.6.0",
    "@vue/tsconfig": "0.9.1",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "happy-dom": "21.0.4",
    "picomatch": "file:vendor/secured-picomatch",
    "pngjs": "7.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "3.3.14"
  },
  "engines": {
    "node": "26.x"
  },
  "overrides": {
    "picomatch": "$picomatch"
  }
}
